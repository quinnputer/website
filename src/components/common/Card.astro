---
type Props = {
  description: string;
  icon: string;
  title: string;
  url: string;
  blank?: boolean;
};

const props = Astro.props;
---

<a
  class="flex justify-between items-center no-underline px-2 md:px-4 py-2 md:py-3 hover:text-foreground hover:border-highlight bg-section-background border border-solid border-section-border"
  target={props.blank ? "_blank" : undefined}
  href={props.url}
>
  <div class="grow">
    <h1 class="text-lg lg:text-xl mb-1">{props.title}</h1>

    <p class="text-foreground-darker w-11/12 text-base lg:text-lg">
      {props.description}
    </p>
  </div>

  <i class={`${props.icon} fa-2x text-foreground-darkest`} />
</a>
